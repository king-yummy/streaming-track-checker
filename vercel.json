{
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        { "type": "host", "value": "streaming-track-checker.vercel.app" }
      ],
      "destination": "https://www.plli-checker.app/$1",
      "permanent": true
    }
  ],
  "crons": [{ "path": "/api/event-reminders", "schedule": "*/1 * * * *" }]
}
